{
	auto_https off
	admin off
}

# Wallet API (direct access)
:{$WALLET_BACKEND_PORT} {
	reverse_proxy http://wallet-api:{$WALLET_BACKEND_PORT}
}

# Dev Wallet Frontend
:{$DEV_WALLET_FRONTEND_PORT} {
	# API calls made by the UI (same-origin /wallet-api/*) go to the backend
	reverse_proxy /wallet-api/* http://wallet-api:{$WALLET_BACKEND_PORT}
	# Everything else goes to the Nuxt frontend
	reverse_proxy http://waltid-dev-wallet:{$DEV_WALLET_FRONTEND_PORT}
}

