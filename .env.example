# .env file for idp Authentik

AUTHENTIK_APP_NAME=my-vm1-federated-app
AUTHENTIK_APP_SLUG=vm1-federated-app
AUTHENTIK_PROVIDER_NAME=vm1-federated-provider
AUTHENTIK_REDIRECT_URIS=https://ocean-node-vm2.oceanenterprise.io:8443/source/oauth/callback/vm1-partner-source/,https://market-git-feat-stage-ocean-enterprise.vercel.app/auth/login,https://market-git-feat-stage-ocean-enterprise.vercel.app/auth/callback/logout
AUTHENTIK_LOGOUT_URI=https://market-git-feat-stage-ocean-enterprise.vercel.app/auth/callback/logout
AUTHENTIK_OUTPUT_FILE=idp_authentik-blueprint.yaml



