# =============================================================================
# PARTICIPANT — .env.config
# End-user configurable variables. Fill in all required values before running
# the environment generation script (participant_environment_configuration.py).
# =============================================================================

# PARAMETERS OF THE CENTRAL COMPONENTS DEPLOYED BY THE DATASPACE OPERATOR
# OE MARKETPLACE
# The URL of the OE Marketplace to which the Dataspace Participant connects. E.g. https://market.demo.oceanenterprise.io
MARKETPLACE_URL=https://market-git-feat-fix-logout-v1-ocean-enterprise.vercel.app/
# ---------------------------------------------------------------------------

# CENTRAL IDENTITY PROVIDER
# The Well-Known URL of the Central Identity Provider deployed by the Dataspace Operator. Provided by the Dataspace Operator.
# Make sure the Central Identity Provider is accessible when you run the initialization.
# E.g. https://ocean-node-vm1-stage.oceanenterprise.io:9443/application/o/main-oidc-app/.well-known/openid-configuration 
CENTRAL_IDP_WELL_KNOWN_URL=https://ocean-node-vm1-stage.oceanenterprise.io:9443/application/o/oe-market/.well-known/openid-configuration

# The Client Id parameter of the OIDC Provider set in the Central Identity Provider for the Marketplace. Provided by the Dataspace Operator.
CENTRAL_IDP_CLIENT_ID=o85c4wp9f1rfntxscxvz4ze8klzz5qjk

# The Client Secret parameter of the OIDC Provider set in the Central Identity Provider for the Marketplace. Provided by the Dataspace Operator.
CENTRAL_IDP_CLIENT_SECRET=QKkdhQ4QDwjs1D1Io5bXvagt-fbB3rCPts4Lhev8s9_

#central provider name
CENTRAL_IDP_PROVIDER_NAME=oe-market

# =============================================================================

# PARAMETERS FOR THE PARTICIPANT COMPONENTS BEING DEPLOYED

# SIGNER SERVER
# Configure the RPC providers for each blockchain on which the Signer Server will execute transactions, along with the corresponding gas‑fee multipliers. Unless explicitly instructed otherwise, it is recommended to keep the default gas‑fee multiplier values. Include in the variable only the blockchains to which the Signer Server connects.
NODE_URI_MAP='[{"11155111":{"key":"<your-sepolia-rpc-provider-url>","multiplier":3}},{"11155420":{"key":"<your-optimism-sepolia-rpc-provider-url>","multiplier":2}},{"10":{"key":"<your-optimism-rpc-provider-url>","multiplier":1.5}},{"1":{"key":"<your-mainnet-rpc-provider-url>","multiplier":2}}]'

# WALLET UI
# The URL the SSI Wallet User Interface
WALLET_UI_URL=https://waltid-ui.oceanenterprise.io
# The Admin User Group Name defined in Authentik. Wallet UI should be used only by admin group.
NUXT_ADMIN_USER_GROUP_NAME=""

# WALLET API
# The URL the SSI Wallet API
WALLET_API_URL=https://waltid-api.oceanenterprise.io
# The walt.id database user password
DB_PASSWORD='your-wallet-api-database-password'

# DATASPACE OPERATOR POSTGRESQL SERVICE
# The rot user password for PostgreSQL service
POSTGRES_PASSWORD='your-root-user-database-password'

# PARTICIPANT IDENTITY PROVIDER (AUTHENTIK)
# The hostname of the Participant Identity Provider
PARTICIPANT_IDP_HOSTNAME=vm1-test.oceanenterprise.io
# The port of the Participant Identity Provider for HTTP connections
PARTICIPANT_IDP_PORT_HTTP=9000
PARTICIPANT_IDP_PORT_HTTPS=9443
# Application and Provider Configuration
AUTHENTIK_APP_SLUG=vm1-test-federated-app
AUTHENTIK_PROVIDER_NAME=vm1-test-federated-provider
# Database connection
AUTHENTIK_POSTGRESQL__PASSWORD=participant-authentik-db-password
AUTHENTIK_SECRET_KEY=participant-authentik-secret-key
# SMTP configuration (uncomment to enable outbound email)
# E-mail address from which emails are sent
AUTHENTIK_EMAIL__FROM=support@oceanenterprise.io
# -- email username and password
AUTHENTIK_EMAIL__USERNAME=support@oceanenterprise.io
AUTHENTIK_EMAIL__PASSWORD='cTaDFot1SvzHk7#'
# -- SMTP server. If SMTP server does not exist, use the default values.
AUTHENTIK_EMAIL__HOST=mail.gandi.net
AUTHENTIK_EMAIL__PORT=587
# Blueprint file created for this specific configuration, which will be imported in the Authentik server
AUTHENTIK_OUTPUT_FILE=participant-authentik-blueprint.yaml
